# ---------------------------------------------------------------------------
# CampusHub configuration. Copy this file to `.env` and adjust the values.
# Never commit your real .env (it is in .gitignore).
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub

# Where the frontend runs (used in email links and CORS)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Sessions: normal login lasts SESSION_TTL_HOURS; "Remember me" lasts REMEMBER_ME_TTL_DAYS
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
# Set to true when the site is served over HTTPS (adds Secure cookies, HSTS, upgrade-insecure-requests)
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy (nginx, Render, Railway…)
TRUST_PROXY=false

# Require users to click an emailed link before they can log in
EMAIL_VERIFICATION_REQUIRED=false
# Optional: only allow these email domains to register, e.g. "college.edu,students.college.edu"
ALLOWED_EMAIL_DOMAINS=

# Email (password reset / verification). Leave SMTP_HOST empty in development:
# emails are then printed in the backend terminal instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusHub <no-reply@campushub.local>

# AI assistant + career recommendations (server-side only, never sent to the browser)
#   none      → clearly labelled built-in "basic assistant" (no API key needed)
#   anthropic → Anthropic Messages API
#   openai    → OpenAI Chat Completions, or any OpenAI-compatible server via AI_BASE_URL
AI_PROVIDER=none
AI_API_KEY=
# A model ID available on your account, e.g. an Anthropic Claude model or an OpenAI GPT model
AI_MODEL=
# Optional: custom endpoint for OpenAI-compatible providers (e.g. http://localhost:11434/v1 for Ollama)
AI_BASE_URL=
AI_TIMEOUT_MS=30000

# Uploaded images (profile pictures, project screenshots)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

RATE_LIMIT_ENABLED=true
# Production: let the API also serve the built React app from frontend/dist
SERVE_FRONTEND=false
LOG_REQUESTS=true
