# ---------------------------------------------------------------------------
# CampusHub configuration. Copy this file to `.env` and adjust the values.
# Never commit your real .env (it is in .gitignore).
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub

# Public URL of the website (used in email links). In production: https://your-domain
APP_URL=http://localhost:5173
# Browser origins allowed to call the API from ANOTHER origin (comma-separated). Only matters
# when the frontend is hosted separately from the API (see README → Deployment).
CORS_ORIGINS=http://localhost:5173

# Sessions: normal login lasts SESSION_TTL_HOURS; "Remember me" lasts REMEMBER_ME_TTL_DAYS
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
# Set to true when the site is served over HTTPS (adds Secure cookies, HSTS, upgrade-insecure-requests)
COOKIE_SECURE=false
# lax (default, recommended: website and API on one URL) | strict | none
# "none" is only for a frontend on a different site than the API, and needs COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Set to true when running behind a reverse proxy (nginx, Render, Railway…) so rate limits see real IPs
TRUST_PROXY=false

# Apply pending database migrations automatically when the server starts
AUTO_MIGRATE=true

# Optional: create the first administrator when the server starts (only if no account uses this
# email yet; existing accounts are never changed). Useful on hosts without a shell. Remove the
# password afterwards. Alternatively run: npm run create-admin -- --email ...
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=CampusHub Admin

# Require users to click an emailed link before they can log in
EMAIL_VERIFICATION_REQUIRED=false
# Optional: only allow these email domains to register, e.g. "college.edu,students.college.edu"
ALLOWED_EMAIL_DOMAINS=

# Email (password reset / verification). Leave SMTP_HOST empty in development:
# emails are then printed in the backend terminal instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusHub <no-reply@campushub.local>

# AI assistant + career recommendations (server-side only, never sent to the browser)
#   none      → clearly labelled built-in "basic assistant" (no API key needed)
#   anthropic → Anthropic Messages API
#   openai    → OpenAI Chat Completions, or any OpenAI-compatible server via AI_BASE_URL
AI_PROVIDER=none
AI_API_KEY=
# A model ID available on your account, e.g. an Anthropic Claude model or an OpenAI GPT model
AI_MODEL=
# Optional: custom endpoint for OpenAI-compatible providers (e.g. http://localhost:11434/v1 for Ollama)
AI_BASE_URL=
AI_TIMEOUT_MS=30000

# Uploaded images (profile pictures, project screenshots)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

RATE_LIMIT_ENABLED=true
# Production: let the API also serve the built React app from frontend/dist (one URL for everything)
SERVE_FRONTEND=false
LOG_REQUESTS=true

# Frontend build setting (read by Vite at build time, not by the API):
# VITE_API_URL=https://api.example.com   only if the website is hosted separately from the API
