# Used by `npm test`. Points at a SEPARATE database: the tests erase it on every run.
NODE_ENV=test
PORT=4100
DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub_test
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=false
LOG_REQUESTS=false
AI_PROVIDER=none
UPLOAD_DIR=uploads-test
