{
  "name": "@campushub/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../.env.test -- vitest run",
    "db:generate": "dotenv -e ../.env -- drizzle-kit generate",
    "db:migrate": "tsx --env-file=../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../.env src/db/seed.ts",
    "db:reset": "tsx --env-file=../.env src/db/reset.ts",
    "db:studio": "dotenv -e ../.env -- drizzle-kit studio",
    "create-admin": "tsx --env-file=../.env src/scripts/createAdmin.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
